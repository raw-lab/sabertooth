[package]
name = "sabertooth"
version = "0.2.0"
edition = "2021"
rust-version = "1.75"
authors = ["Richard Allen White III <rwhit101@uncc.edu>", "RAW Lab <github.com/raw-lab>"]
description = "A pure-Rust reimplementation of the MMseqs2 profile/PSSM sensitivity core (search, clustering, taxonomy, translated & profile-profile search)."
license = "MIT"
readme = "README.md"
repository = "https://github.com/raw-lab/sabertooth"
homepage = "https://github.com/raw-lab/sabertooth"
keywords = ["bioinformatics", "mmseqs2", "alignment", "proteins", "homology"]
categories = ["science", "command-line-utilities"]
# Keep the published crate lean: dev-only reference scripts and scratch data are
# not part of the library/binary.
exclude = ["compare/", "STEPS.md", "*.tar.gz"]

[[bin]]
name = "sabertooth"
path = "src/main.rs"

[lib]
name = "sabertooth"
path = "src/lib.rs"

[dependencies]
rayon = "=1.10.0"
# Optional distributed backend: RAW-lab HydraMPP, pulled from crates.io like any
# other dependency. Off by default so the ordinary build stays dependency-light;
# enable with `--features distributed`. Sabertooth remains a single crate.
hydra-mpp-core = { version = "1.0.0", optional = true }
serde = { version = "1", features = ["derive"], optional = true }

[features]
default = []
# Distribute search across HydraMPP workers/nodes (also pulls in serde for the
# task wire types). GPU-aware scheduling (`--gpus`) rides on this feature too.
distributed = ["dep:hydra-mpp-core", "dep:serde"]

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
panic = "abort"
